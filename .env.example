# .env.example

# ── Chrome 用户数据目录 ──────────────────────────
# 默认使用项目内的 chrome_data 目录（已包含已登录的 Google 账号数据）
# Linux / macOS
CHROME_USER_DATA_DIR=/home/ubuntu/google_flow_mcp/chrome_data
# Windows（使用正斜杠或双反斜杠）
# CHROME_USER_DATA_DIR=C:/Users/YourName/google_flow_mcp/chrome_data

CHROME_PROFILE_DIRECTORY=Default

# Chrome 默认下载目录（留空则使用系统默认）
# Linux / macOS
# CHROME_DOWNLOAD_DIR=/home/ubuntu/Downloads/google_flow
# Windows
# CHROME_DOWNLOAD_DIR=C:/Users/YourName/Downloads/google_flow
CHROME_DOWNLOAD_DIR=

# Chrome 可执行文件路径（留空则由 DrissionPage 自动探测）
# Linux:   /usr/bin/google-chrome
# macOS:   /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Windows: C:/Program Files/Google/Chrome/Application/chrome.exe
CHROME_BINARY_PATH=

GOOGLE_FLOW_BASE_URL=https://flow.google.com
LOG_LEVEL=INFO

# browser_config.yaml 的路径（相对或绝对均可）
BROWSER_CONFIG_PATH=browser_config.yaml
